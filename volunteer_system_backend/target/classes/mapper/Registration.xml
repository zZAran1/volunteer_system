<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.volunteer_system.mapper.RegistrationMapper">
    <insert id="insertRegistration">
        INSERT IGNORE INTO registration (activity_id, registrant_id)
        VALUES (#{activityId}, #{registrantId})
    </insert>
</mapper>